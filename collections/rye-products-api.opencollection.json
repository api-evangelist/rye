        {
          "info": {
            "name": "Unsubscribe from product events",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://staging.api.rye.com/api/v1/products/unsubscribe",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "apikey",
              "key": "Authorization",
              "value": "{{Authorization}}",
              "placement": "header"
            }
          },
          "docs": "Unsubscribe from product events from a store."
        }
      ]
    }
  ],
  "bundled": true
