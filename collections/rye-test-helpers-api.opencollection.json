{
  "opencollection": "1.0.0",
  "info": {
    "name": "Universal Checkout Betas Test Helpers API",
    "version": "1.0.5"
  },
  "items": [
    {
      "info": {
        "name": "Test Helpers",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Advance simulated shipment",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://staging.api.rye.com/api/v1/test-helpers/checkout-intents/:checkoutIntentId/shipments/advance",
            "params": [
              {
                "name": "checkoutIntentId",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "Authorization",
              "value": "{{Authorization}}",
              "placement": "header"
            }
          },
          "docs": "Advance the simulated shipment for a checkout intent. To trigger delayed or\ncanceled shipping scenarios, create the checkout intent with a matching\nshipping and delivery test product:\nhttps://rye.com/docs/api-v2/testing/test-products#shipping-&-delivery"
        },
        {
          "info": {
            "name": "Create simulated return",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://staging.api.rye.com/api/v1/test-helpers/returns",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "apikey",
              "key": "Authorization",
              "value": "{{Authorization}}",
              "placement": "header"
            }
          },
          "docs": "Create a simulated return for an order, then drive it through its lifecycle\nwith the approve/deny/refund/fail helpers below."
        },
        {
          "info": {
            "name": "Approve simulated return",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://staging.api.rye.com/api/v1/test-helpers/returns/:returnId/approve",
            "params": [
              {
                "name": "returnId",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "apikey",
              "key": "Authorization",
              "value": "{{Authorization}}",
              "placement": "header"
            }
          },
          "docs": "Approve a simulated return."
        },
        {
          "info": {
            "name": "Deny simulated return",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://staging.api.rye.com/api/v1/test-helpers/returns/:returnId/deny",
            "params": [
              {
                "name": "returnId",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "apikey",
              "key": "Authorization",
              "value": "{{Authorization}}",
              "placement": "header"
            }
          },
          "docs": "Deny a simulated return."
        },
        {
          "info": {
            "name": "Refund simulated return",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://staging.api.rye.com/api/v1/test-helpers/returns/:returnId/refund",
            "params": [
              {
                "name": "returnId",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "apikey",
              "key": "Authorization",
              "value": "{{Authorization}}",
              "placement": "header"
            }
          },
          "docs": "Refund a simulated return using the order total as the simulated refund\namount."
        },
        {
          "info": {
            "name": "Fail simulated return",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://staging.api.rye.com/api/v1/test-helpers/returns/:returnId/fail",
            "params": [
              {
                "name": "returnId",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "apikey",
              "key": "Authorization",
              "value": "{{Authorization}}",
              "placement": "header"
            }
          },
          "docs": "Mark a simulated return as failed."
        }
      ]
    }
  ],
  "bundled": true
}