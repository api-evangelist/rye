{
  "opencollection": "1.0.0",
  "info": {
    "name": "Universal Checkout Betas Events API",
    "version": "1.0.5"
  },
  "items": [
    {
      "info": {
        "name": "Events",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List events",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://staging.api.rye.com/api/v1/events",
            "params": [
              {
                "name": "limit",
                "value": "20",
                "type": "query",
                "description": "Maximum number of results to return (default 100)"
              },
              {
                "name": "after",
                "value": "",
                "type": "query"
              },
              {
                "name": "before",
                "value": "",
                "type": "query"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "Authorization",
              "value": "{{Authorization}}",
              "placement": "header"
            }
          },
          "docs": "Retrieve a paginated list of events."
        },
        {
          "info": {
            "name": "Retrieve event",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://staging.api.rye.com/api/v1/events/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "Authorization",
              "value": "{{Authorization}}",
              "placement": "header"
            }
          },
          "docs": "Retrieves an event by ID."
        },
        {
          "info": {
            "name": "Trigger event",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://staging.api.rye.com/api/v1/events/trigger",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "apikey",
              "key": "Authorization",
              "value": "{{Authorization}}",
              "placement": "header"
            }
          },
          "docs": "Trigger a webhook event for a product on demand, in the shape your\nregistered destinations would normally receive. Use during integration\ntesting to exercise your handlers without waiting for an upstream update.\n\nThe event is targeted at the calling developer only. Pass an\n`Idempotency-Key` header so retried calls produce the same event ID and\nthe delivery layer dedups."
        }
      ]
    }
  ],
  "bundled": true
}