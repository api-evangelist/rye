      "item": [
        {
          "id": "da3f8db7-afa4-4afb-866e-b01633a9aa42",
          "name": "Create merchant connector installation link",
          "request": {
            "name": "Create merchant connector installation link",
            "description": {
              "content": "Generate an installation link for a merchant connector (e.g. Shopify).\n\nThe returned URL begins the connector's OAuth handshake. Direct the\nmerchant to it; once they authorize the Rye app, the connector redirects\nback to Rye to complete the install. The merchant is attributed to the\ncalling developer and becomes available for checkout via this account.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v1",
                "merchant-connectors",
                ":connector",
                "installation-link"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "storeUrl",
                  "value": "<string>",
                  "description": "(Required) Domain or URL of the merchant store to generate the installation link for"
                },
                {
                  "disabled": false,
                  "key": "private",
                  "value": "<boolean>",
                  "description": "If true, the merchant onboarded via this link is exclusive to the calling developer"
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "connector",
                  "description": "(Required) The merchant connector to generate an installation link for"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": {
              "type": "apikey",
              "apikey": [
                {
                  "key": "key",
                  "value": "Authorization"
                },
                {
                  "key": "value",
                  "value": "{{apiKey}}"
                },
                {
                  "key": "in",
                  "value": "header"
                }
              ]
            }
          },
          "response": [
            {
