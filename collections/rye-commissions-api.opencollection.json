{
  "opencollection": "1.0.0",
  "info": {
    "name": "Universal Checkout Betas Commissions API",
    "version": "1.0.5"
  },
  "items": [
    {
      "info": {
        "name": "Commissions",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Retrieve commission",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://staging.api.rye.com/api/v1/commissions/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "The id of the commission to look up"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "Authorization",
              "value": "{{Authorization}}",
              "placement": "header"
            }
          },
          "docs": "Retrieve a commission by id\n\nReturns commission details for the authenticated developer."
        },
        {
          "info": {
            "name": "List commissions",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://staging.api.rye.com/api/v1/commissions",
            "params": [
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Maximum number of results to return (default 100)"
              },
              {
                "name": "after",
                "value": "",
                "type": "query",
                "description": "Cursor from a previous response's `pageInfo.endCursor`"
              },
              {
                "name": "before",
                "value": "",
                "type": "query",
                "description": "Cursor from a previous response's `pageInfo.startCursor`"
              },
              {
                "name": "type",
                "value": "",
                "type": "query"
              },
              {
                "name": "status",
                "value": "",
                "type": "query"
              },
              {
                "name": "checkoutIntentId",
                "value": "",
                "type": "query"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "Authorization",
              "value": "{{Authorization}}",
              "placement": "header"
            }
          },
          "docs": "List commissions for the authenticated developer\n\nReturns a paginated list of commissions with optional filters using\ncursor-based pagination. Pass the `endCursor` from a previous response\nas `after` to fetch the next page, or the `startCursor` as `before` to\nfetch the previous page. Specifying both `after` and `before` returns 422."
        }
      ]
    }
  ],
  "bundled": true
}